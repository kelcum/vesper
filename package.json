{
  "name": "vesper",
  "private": true,
  "version": "0.2.0",
  "description": "A calm, honest Roblox launcher for Windows.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
